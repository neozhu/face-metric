+    cy = (y0 + y1) / 2.0
+    nx0 = int(np.floor(cx - desired_w / 2.0))
+    ny0 = int(np.floor(cy - desired_h / 2.0))
+    nx1 = nx0 + desired_w
+    ny1 = ny0 + desired_h
+
+    if nx0 < 0:
+        nx1 -= nx0
+        nx0 = 0
+    if ny0 < 0:
+        ny1 -= ny0
+        ny0 = 0
+    if nx1 > img_w:
+        dx = nx1 - img_w
+        nx0 -= dx
+        nx1 = img_w
+    if ny1 > img_h:
+        dy = ny1 - img_h
+        ny0 -= dy
+        ny1 = img_h
+
+    nx0 = max(0, min(nx0, img_w))
+    ny0 = max(0, min(ny0, img_h))
+    nx1 = max(0, min(nx1, img_w))
+    ny1 = max(0, min(ny1, img_h))
